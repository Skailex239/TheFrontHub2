# Redirection permanente de l'ancien espace tâches vers l'espace admin.
# (thefronthub.com/task/* et task.thefronthub.com/* → admin.thefronthub.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ https://admin.thefronthub.com/ [R=301,L]
</IfModule>

# Filet si mod_rewrite est indisponible
ErrorDocument 404 https://admin.thefronthub.com/
