rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// firestore.rules — TheFrontHub (audit sécurité 2026)
//
// Règles durcies correspondant EXACTEMENT aux flux du client
// (app.js, profile.js, dashboard.js, reward-codes.js, auth.js).
//
// ⚠️ AVANT DE PUBLIER dans la console Firebase, lire SECURITE_CORRECTIONS.md
//    (ordre de déploiement + prérequis). Résumé des flux autorisés :
//
//   users/{uid}            : propriétaire uniquement (inscription, profil, settings)
//   public-aliases/{uid}   : lecture publique, écriture par le propriétaire (uid = doc id)
//   public-rewards/{uid}   : lecture publique, écriture par le propriétaire (uid = doc id)
//   likes/{runId}          : lecture publique, écriture par tout utilisateur AUTHENTIFIÉ
//                            (compteur + map d'utilisateurs, comme fait app.js)
//   reward-codes/{code}    : lecture publique (validation du rachat côté client),
//                            écriture UNIQUEMENT par un admin (custom claim token.admin == true)
//   user-skins/{pid_skin}  : lecture publique (affichage du skin actif),
//                            création uniquement pour SON propre publicId (lié dans
//                            users/{uid}.publicId) avec une forme de document validée,
//                            update limité au champ "active" (activation de skin)
//
// Les collections non listées ci-dessous sont refusées par défaut (deny all).
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = custom claim "admin: true" posé via le SDK Admin / console.
    // (Jamais un token en clair côté client — voir audit sécurité.)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Le publicId du compte courant (posé à la vérification de profil).
    // get() est mis en cache par Firestore : coût nul si déjà lu dans la requête.
    function myPublicId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId;
    }

    // ── users/{uid} : données de compte, propriétaire uniquement ─────────────

    match /users/{uid} {
      allow get, list: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();

      // Note : le client ne doit jamais pouvoir s'auto-attribuer un rôle.
      // Les champs sensibles éventuels (isAdmin, role, admin) ne sont pas
      // écrits par le client ; si tu en ajoutes, restreins-les ici, ex. :
      //   && !request.resource.data.diff(resource.data)
      //        .affectedKeys().hasAny(['role', 'isAdmin'])
    }

    // ── public-aliases/{uid} : bridge publicId ↔ username (lecture publique) ─

    match /public-aliases/{uid} {
      allow get, list: if true;                                        // viewers non connectés
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── public-rewards/{uid} : matching VIP par publicId (lecture publique) ──

    match /public-rewards/{uid} {
      allow get, list: if true;                                        // viewers non connectés
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── likes/{runId} : boutons GG (lecture publique, écriture authentifiée) ─

    match /likes/{runId} {
      allow get, list: if true;
      // create : setDoc(merge) {count: increment(1), users: {uid: true}} (app.js toggleGG)
      // ⚠️ Pas de validation de la VALEUR de count : increment() est un
      //    field transform que les règles ne résolvent pas de façon fiable.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['count', 'users'])
                    && request.resource.data.users is map
                    && request.resource.data.users.keys().hasOnly([request.auth.uid]);
      // update : like (increment +1) et unlike (increment -1 + deleteField users.<uid>)
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['count', 'users']);
      allow delete: if isAdmin();
    }

    // ── reward-codes/{code} : codes de récompense ─────────────────────────────
    // Lecture publique nécessaire : le client lit le doc pour valider un rachat
    // (redeemCode). L'ÉCRITURE est réservée à l'admin — plus AUCUN token
    // magique côté client (l'ancien "skailex-admin-2025" a été supprimé).

    match /reward-codes/{code} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── user-skins/{publicId_skinId} : skins possédés/actifs ─────────────────

    match /user-skins/{skinDocId} {
      allow get, list: if true;                                        // affichage du skin actif

      // Création (flux redeemCode, transaction) : utilisateur connecté,
      // pour SON publicId uniquement, forme de document verrouillée.
      allow create: if isSignedIn()
                    && request.resource.data.keys()
                         .hasOnly(['publicId', 'skinId', 'codeUsed', 'redeemedAt', 'active'])
                    && request.resource.data.publicId == myPublicId()
                    && request.resource.data.active == false
                    && request.resource.data.skinId is string
                    && request.resource.data.codeUsed is string
                    && request.resource.data.redeemedAt is string;

      // Activation/désactivation (activateSkin) : uniquement le champ "active",
      // et uniquement sur les docs de SON publicId.
      allow update: if isSignedIn()
                    && resource.data.publicId == myPublicId()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['active'])
                    && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    // ── Tout le reste : refus par défaut ──────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
