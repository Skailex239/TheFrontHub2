# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — TheFrontHub
# Site statique (vanilla JS, build esbuild) + API PHP (o2switch) + scripts sync.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node / build ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Secrets / env (jamais dans le repo) ───────────────────────────────────────
.env*
*.pem
*.key
_upload.php.local
SECURITE_CORRECTIONS.md

# ── Travail agents / IA (ne jamais pousser) ───────────────────────────────────
_wip-auth-mysql/
agent-ctx/
.trae/
.windsurf/
.zscripts/
.claude/
.z-ai-config
/skills/
/tool-results/
prompt

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
dev.log
dev.out.log
server.log

# ── Captures d'écran de debug (jamais de PNG dans le repo) ────────────────────
*.png
!PDP.png
!TheFrontHub Logo No Text.png
!TheFrontHub Logo Text.png
!favicon-*.png

# ── Backups ───────────────────────────────────────────────────────────────────
*backup.json
*full.json
.backup-ui-avant/

# ──────────────────────────────────────────────────────────────────────────────
# DONNÉES DE SYNC — produites par GitHub Actions, publiées dans la release
# GitHub « data-latest », installées en prod par pull-data.sh (cron o2switch).
# NE JAMAIS COMMIT : l'état et les gros fichiers vivent dans la release.
# Récupération locale : ./scripts/data-release.sh pull <fichiers...>
# ──────────────────────────────────────────────────────────────────────────────

# Snapshots / payloads publics (régénérés à chaque sync)
/lobby_state.json
/ranked.json
/ranked.json.gz
/teams.json
/teams.json.gz
/teams_runs.json
/teams_runs.json.gz
/teams_seen.json
/teams_checkpoint.json
/teams_public.json
/teams_public.json.gz
/dashboard_scores.json
/dashboard_scores.json.gz
/dashboard_ranking.json
/dashboard_player_games.json
/runs_public.json
/runs_public.json.gz
/runs_compact_public.json
/runs_compact_public.json.gz
/clans.json
/clans.json.gz
/news.json
/news.json.gz

# État interne des syncs (checkpoints, seen, players suivis)
/checkpoint.json
/checkpoint_compact.json
/seen.json
/seen_compact.json
/sync-players.json

# Archives lourdes (fallback, rotation)
/runs.json.gz
/runs_compact.json.gz
/ranked_history.json
/ranked_history.json.gz
/ranked_2v2_history.json
/ranked_2v2_history.json.gz

# Données joueurs individuelles (tarball player-files.tar.gz en release)
/player-data/
/player-stats/

# Archives locales (rotation _upload.php, si réactivé un jour)
/_archives/
