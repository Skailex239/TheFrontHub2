generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Registre des joueurs OpenFront croisés par le tableau de bord.
// On y upserte chaque joueur vu dans les classements / parties afin de garder
// un pseudo stable entre deux rafraîchissements et de tracer les renommages
// (au lieu de « changer les pseudos » silencieusement).
model Player {
  publicId      String    @id
  username      String
  prevUsernames Json      @default("[]")
  tracked       Boolean   @default(false)
  source        String    @default("leaderboard")
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastRenamedAt DateTime?
  elo           Int?
  wins          Int?
  losses        Int?

  @@index([tracked])
  @@index([username])
}
