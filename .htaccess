# ─────────────────────────────────────────────────────────────────────────────
# .htaccess — TheFrontHub.com — Optimisation performance + sécurité
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Forcer HTTPS ──
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 1bis. Zones internes interdites d'accès public (audit sécurité) ──
# Archives horodatées des données (backups internes, jamais servies au navigateur)
RewriteRule ^_archives(/|$) - [F,L]
# Dossier interne de travail agents/IA
RewriteRule ^agent-ctx(/|$) - [F,L]
# Work-in-progress : migration auth MySQL (jamais servi au navigateur)
RewriteRule ^_wip-auth-mysql(/|$) - [F,L]
# Dossiers de développement (jamais servis : le site ne charge que dist/ + shared/)
RewriteRule ^(scripts|src|tests|prisma|db|screenshots|public|cloudflare-worker|mini-services|examples|download|agent-ctx)(/|$) - [F,L]
# Fichiers internes de sync Node.js (contiennent des patterns d'appel API privilégiés)
RewriteRule ^(server|openfront-api|generate-code|detect-new-players|compute-player-stats|validate-sync|investigate-sync|backfill-teams|find-bug-games|check-game-detail|quantify-bug|test-extract-team|test-api|perf-test|build)\.js$ - [F,L]
RewriteRule ^sync[a-z-]*\.js$ - [F,L]

# ── 1ter. DEV — porte d'accès à code (gate.php) ──────────────────────────
# Actif UNIQUEMENT sur dev.thefronthub.com : thefronthub.com (prod) reste
# 100 % public, même si ce fichier y était un jour copié.
# Sans session valide, tout passe par gate.php (pages statiques + /api/
# inclus par PHP), sauf le gate lui-même et les endpoints webhook appelés
# par GitHub (sans cookie de session).
RewriteCond %{HTTP_HOST} ^dev\.thefronthub\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/gate\.php$
RewriteCond %{REQUEST_URI} !^/_deploy\.php$
RewriteCond %{REQUEST_URI} !^/_upload\.php$
# Rapports CSP : POST navigateur sans cookie (cf. section 16) — ne pas
# les faire avaler par la porte, sinon plus aucun rapport sur dev.
RewriteCond %{REQUEST_URI} !^/api/csp-report\.php$
RewriteRule ^ /gate.php [L]

# DEV : la config de la porte (secure/) n'est jamais servie en HTTP
RewriteCond %{HTTP_HOST} ^dev\.thefronthub\.com$ [NC]
RewriteRule ^secure(/|$) - [F,L]

# ── 2. Page par défaut ──
DirectoryIndex index.html

# ── 3. Compression (tous types textuels + SVG + JSON) ──
# ⚠️ Perf (audit 2026-08-27) : les .json étaient servis NON compressés (350 Ko
# pour un JSON tournoi !). o2switch compresse html/css/js via brotli au niveau
# serveur mais PAS application/json. On force donc :
#   1. mod_brotli (prioritaire — o2switch/Apache 2.4 le propose)
#   2. mod_deflate en repli (gzip)
# Les fichiers .json.gz existants passent à travers (déjà compressés, le filtre
# ne s'applique pas aux types application/gzip).
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json text/json
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf font/woff font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/ld+json text/json
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ── 4. Cache navigateur longue durée (assets statiques) ──
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets versionnés (cache 1 an) — ne changent jamais car "?v=N" change quand on update
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images (cache 1 an)
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (cache 1 an)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Fichiers JSON (cache 5 min — changent souvent via sync)
  ExpiresByType application/json "access plus 5 minutes"

  # HTML (cache 5 min — peu de changements)
  ExpiresByType text/html "access plus 5 minutes"

  # Fichiers spéciaux (pas de cache)
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

# ── 5. Cache-Control headers (complément d'Expires) ──
<IfModule mod_headers.c>
  # Assets statiques versionnés : immutable (le navigateur ne re-valide jamais)
  <FilesMatch "\.(css|js|png|jpe?g|webp|gif|svg|ico|ttf|otf|woff2?|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML : must-revalidate (vérifie si modifié)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # JSON : must-revalidate (changements fréquents via sync)
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # JSON.gz : must-revalidate
  <FilesMatch "\.json\.gz$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Désactiver le cache pour les endpoints PHP dynamiques
  <FilesMatch "^_(upload|deploy)\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

  # X-Content-Type-Options (sécurité)
  Header set X-Content-Type-Options "nosniff"

  # X-Frame-Options (sécurité — empêche le clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"

  # Referrer-Policy (sécurité)
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy (sécurité — désactive les API navigateur inutilisées)
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # HSTS (force HTTPS pour 1 an)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── 6. UTF-8 par défaut ──
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .svg

# ── 7. ETag réactivés (audit P0-3) ────────────────────────────────────────
# « FileETag None » empêchait TOUTE validation conditionnelle : avec
# must-revalidate, le navigateur revalide mais sans ETag il ne peut PAS
# envoyer If-None-Match → le serveur renvoyait 200 + le fichier ENTIER
# (36 Ko pour l'accueil, plusieurs Mo pour les JSON gz) toutes les 5 min,
# au lieu d'un 304 de quelques octets.
# MTime Size : portable (indépendant des inodes, identique derrière un
# éventuel ré-équilibrage de serveurs o2switch).
FileETag MTime Size

# ── 8. Sécurité : bloquer accès aux fichiers sensibles ──
# Dotfiles (.env, .git, .htaccess…), docs internes, scripts, config,
# fichiers Node de dev (sync*, server.js, generate-code.js…), Caddyfile
<FilesMatch "(^\.|\.(env|md|yml|yaml|lock|sh|ps1|py|ini|log|pem|key|sql|db)$|^Caddyfile$|^package(-build)?\.json$|^(server|openfront-api|generate-code|detect-new-players|compute-player-stats|validate-sync|investigate-sync|backfill-teams|find-bug-games|check-game-detail|quantify-bug|test-extract-team|test-api|perf-test)\.js$|^sync[a-z-]*\.js$|\.map$)">
  Require all denied
</FilesMatch>

# ── 9. Bloquer accès aux endpoints PHP en GET (POST only) ──
<Files "_upload.php">
  <Limit GET HEAD OPTIONS>
    Require all denied
  </Limit>
</Files>
<Files "_deploy.php">
  <Limit GET HEAD OPTIONS>
    Require all denied
  </Limit>
</Files>

# ── 10. PageSpeed (o2switch PowerBoost) — désactiver pour éviter les weird URLs ──
# PowerBoost ajoute des URLs bizarres comme lobby.js,qv=25.pagespeed.ce.xxx.js
# qui cassent le cache navigateur et ralentissent le site
<IfModule mod_pagespeed.c>
  ModPagespeed off
</IfModule>
<IfModule pagespeed_module>
  ModPagespeed off
</IfModule>

# ── 11. Précharger les ressources critiques (preload hints) ──
# Le HTML ajoute déjà des <link rel="preload"> dans le <head>,
# mais on peut aussi ajouter des HTTP/2 Server Push ici si besoin
# (mais ça peut ralentir si abusé, donc on laisse désactivé par défaut)

# ── 12. Charset pour les JSON ──
<FilesMatch "\.json$">
  ForceType application/json
  AddCharset UTF-8 .json
</FilesMatch>

# ── 13. MIME types pour les fichiers modernes ──
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ── 14. Désactiver le suivi des répertoires (sécurité) ──
Options -Indexes

# ── 15. Page 404 personnalisée (audit P1-8) ─────────────────────────────
# Avant : 404 Apache générique (page blanche technique, aucun lien de
# récupération → visite perdue). 404.html est cohérente avec le design du
# site (thème clair/sombre respecté) et propose 3 sorties vers l'accueil.
# ⚠️ Le .htaccess racine est géré manuellement sur le serveur (exclu du
# rsync de deploy.sh) : recopier ce fichier une fois via cPanel.
ErrorDocument 404 /404.html

# ── 16. Content-Security-Policy (audit P1-3) ─────────────────────────────
# Inventaire complet des ressources externes fait sur *.html + *.js + dist
# (Google Fonts, AdSense/GTM, API+WS OpenFront, proxies CORS, miniatures
# GitHub). 'unsafe-inline' requis (JS inline historique partout — passer
# aux nonces serait un chantier dédié). Rapports → /api/csp-report.php
# (stockés dans api/csp-reports.jsonl, non servi par Apache).
# En cas de blocage inattendu d'une ressource : consulter le journal de
# rapports, ajouter le domaine à la directive concernée, ou commenter
# l'en-tête le temps de corriger.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://pagead2.googlesyndication.com https://www.googletagmanager.com https://tpc.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://raw.githubusercontent.com https://minhkarl.github.io https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com; connect-src 'self' https://api.openfront.io https://openfront-proxy.diofortnite3.workers.dev wss://openfront.io wss://blue.openfront.io wss://green.openfront.io wss://openfront-proxy.diofortnite3.workers.dev https://api.github.com https://corsproxy.io https://api.codetabs.com https://api.allorigins.win https://thingproxy.freeboard.io https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com; media-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report.php"

# ── 17. SSR léger game.html / clan.html (audit P1-7) ────────────────────
# Réécriture INTERNE (l'URL visible reste game.html / clan.html) vers les
# vues PHP qui calculent les métadonnées serveur (titre, description,
# Open Graph, JSON-LD, canonical dynamique) à partir de MySQL. Sans règle
# active (recopie manuelle serveur non faite), game.html/clan.html sont
# servis comme aujourd'hui : coquilles JS. Avec la règle : crawleurs et
# partages réseaux sociaux reçoivent un titre/description par partie/clan.
# NB : placé APRÈS le bloc gate dev — sur dev.thefronthub.com la porte
# continue d'intercepter ces pages (dev noindex) ; la prod (thefronthub.com)
# n'a pas de gate → réécriture active.
RewriteRule ^game\.html$ game-view.php [L]
RewriteRule ^clan\.html$ clan-view.php [L]
